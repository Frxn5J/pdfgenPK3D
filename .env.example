# App
PORT=3000
NODE_ENV=development

# Admin
ADMIN_USERNAME=Frxn5J
ADMIN_PASSWORD=change_me
SESSION_SECRET=change_me_to_a_long_random_value

# n8n, static bearer token n8n must send as 'Authorization: Bearer <token>'
# to create quotes via POST /api/n8n/quotes. Generate one with: openssl rand -hex 32
N8N_API_KEY=

# n8n webhook to send quotes to client's WhatsApp.
# Configure your n8n workflow to receive the webhook and send the PDF via WhatsApp Business API.
N8N_WEBHOOK_WHATSAPP_URL=

# AI descriptions, OpenAI-compatible chat completions
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.7
LLM_DESCRIPTION_MAX_WORDS=45

# AI image enhancement, Qwen Image/custom endpoint
QWEN_IMAGE_BASE_URL=
QWEN_IMAGE_ROUTE=/v1/images/edits
QWEN_IMAGE_ENDPOINT=
QWEN_IMAGE_API_KEY=
QWEN_IMAGE_MODEL=
QWEN_IMAGE_PROMPT=
QWEN_IMAGE_TIMEOUT_MS=120000

# Optional aliases supported by the app for custom image endpoints
IMAGE_ENHANCE_BASE_URL=
IMAGE_ENHANCE_ROUTE=
IMAGE_ENHANCE_ENDPOINT=
IMAGE_ENHANCE_API_KEY=
IMAGE_ENHANCE_MODEL=
